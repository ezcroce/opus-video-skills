# --- Instagram / Meta -------------------------------------------------------
# App Meta con prodotto "Instagram" e "Instagram Login".
# Guida: docs/setup-instagram-api.md
IG_APP_ID=
IG_APP_SECRET=
# Deve combaciare, carattere per carattere, con il redirect URI registrato nell'app Meta.
IG_REDIRECT_URI=http://localhost:4321/auth/callback
# Stringa che scegli tu, da inserire anche nella configurazione del webhook.
IG_WEBHOOK_VERIFY_TOKEN=cambiami-con-qualcosa-di-segreto
# Opzionale: nasconde in automatico i commenti segnati come spam.
IG_HIDE_SPAM=false
# Opzionale: versione della Graph API.
IG_API_VERSION=v23.0

# --- Modello linguistico (facoltativo) --------------------------------------
# Senza chiave, le bozze sono scritte dal motore locale (prudente, un po' rigido).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Server -----------------------------------------------------------------
PORT=4321
HOST=0.0.0.0
